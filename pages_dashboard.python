import streamlit as st
import requests
import pandas as pd
import time

st.title("📊 Market Dashboard")

pair = st.selectbox("Pilih Pair", ["BTC/IDR", "ETH/IDR", "BNB/IDR"])

placeholder = st.empty()

while st.button("Start Market Feed"):

    for _ in range(1000):

        data = requests.get("https://indodax.com/api/ticker/btcidr").json()["ticker"]

        df = pd.DataFrame({
            "last": [float(data["last"])],
            "high": [float(data["high"])],
            "low": [float(data["low"])],
            "volume": [float(data["vol_24h"])]
        })

        placeholder.dataframe(df)
        time.sleep(1)
